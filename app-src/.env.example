# ------------------------------------------------------------
# SIFAU — Variáveis de ambiente
# Copie para .env e preencha.
# ------------------------------------------------------------

# Supabase (obrigatório para produção)
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Chave de serviço (Service Role) — NUNCA exponha no client, apenas em
# scripts server-side (scripts/seed.ts) e em rotas que precisem do
# Supabase Admin API. Encontre em: Supabase > Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Banco PostgreSQL (para conexão direta se necessário)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ------------------------------------------------------------
# IA generativa (classificação de ocorrências)
# O app funciona 100% sem isso — cai no classificador heurístico local.
# Qualquer endpoint OpenAI-compatible funciona (Gemini, OpenAI, Groq…).
# ------------------------------------------------------------
# Chave da API (ex.: Google AI Studio → chave do Gemini)
SIFAU_LLM_API_KEY=
# Base URL OpenAI-compatible (padrão: Gemini)
SIFAU_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Modelo (padrão: Gemini Flash)
SIFAU_LLM_MODEL=gemini-2.0-flash

# ------------------------------------------------------------
# Storage local (apenas para desenvolvimento)
# Não use em produção - configure Supabase Storage
# ------------------------------------------------------------
SIFAU_ALLOW_LOCAL_DISK_STORAGE=false
# Bucket público do Supabase Storage usado em produção para fotos
SIFAU_MEDIA_BUCKET=sifau-media
